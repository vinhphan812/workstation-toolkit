{
  "_warning": "Configured commands are executable code. Prefer {\"argv\": [...]} so arguments are passed literally without a shell. {\"shell\": \"...\"} is interpreted by the platform shell and requires the operator to pass --allow-shell (or set WORKSTATION_ALLOW_SHELL=1).",
  "projects": [
    {
      "name": "example-project",
      "path": "/absolute/path/to/project",
      "type": "python",
      "environment": {},
      "commands": {
        "status": {"argv": ["git", "status", "--short"]},
        "test": {"argv": ["python", "-m", "pytest"]},
        "lint": {"argv": ["python", "-m", "ruff", "check", "."]}
      },
      "timeouts": {"test": 900, "lint": 300}
    }
  ]
}
